{% for r in results %}export const {{ r.ep }}_PARAMS = {
  POLL_INTERVAL_MS: {{ r.pollIntervalMs }},
  COLD_START_LATENCY_MS: {{ r.coldStartLatencyMs }},
  JITTER_MS_MIN: {{ r.jitterMsMin }},
  JITTER_MS_MAX: {{ r.jitterMsMax }},
} as const;

{% endfor %}
export const JITTER_SEED = 20261019;

// The registry is anchored on globalThis: `next dev` compiles each route as
// its own bundle and can instantiate this module once per bundle, so a
// module-local Map would fork the submit route's timeline from the poll
// route's. One global Map — the same handle, one timeline, every bundle.
const GLOBAL_KEY = "__warehouseSimSubmitTimes";
const globalRegistry = globalThis as unknown as Record<string, Map<string, number> | undefined>;
const submitTimes: Map<string, number> = globalRegistry[GLOBAL_KEY] ?? new Map();
globalRegistry[GLOBAL_KEY] = submitTimes;

/** Record the submit wall-clock for a handle (first write wins — replays of
 * the same handle must not move the timeline). */
export function recordSubmitTime(handle: string, atMs: number = Date.now()): number {
  const existing = submitTimes.get(handle);
  if (existing !== undefined) return existing;
  submitTimes.set(handle, atMs);
  return atMs;
}

export function submitTimeOf(handle: string): number | undefined {
  return submitTimes.get(handle);
}

/** FNV-1a 32-bit over "seed:handle" → deterministic jitter in [minMs, maxMs]. */
export function handleJitterMs(
  handle: string,
  minMs: number,
  maxMs: number,
  seed: number = JITTER_SEED,
): number {
  let h = 0x811c9dc5;
  const input = `${seed}:${handle}`;
  for (let i = 0; i < input.length; i++) {
    h ^= input.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  const span = maxMs - minMs + 1;
  return minMs + (h % span);
}

/** Graph-declared cold-start state machine, parameterized by the endpoint's
 * rendered constants and the handle's deterministic jitter offset:
 * QUEUED until coldStart - jitter, RUNNING until coldStart + jitter, then
 * SUCCEEDED. */
export function pollStateFor(
  elapsedMs: number,
  jitterMs: number,
  coldStartMs: number,
): "QUEUED" | "RUNNING" | "SUCCEEDED" {
  if (elapsedMs < coldStartMs - jitterMs) return "QUEUED";
  if (elapsedMs < coldStartMs + jitterMs) return "RUNNING";
  return "SUCCEEDED";
}

/** Snowflake SQL API v2: derive the statement handle from the 202 Location
 * header. Lives in lib (not the route module) so the route file keeps only
 * route-legal exports. */
export function statementHandleFromLocation(location: string | null): string {
  if (!location) throw new Error("missing Location header on 202");
  const last = location.split("/").filter(Boolean).pop();
  if (!last) throw new Error("cannot derive statementHandle from Location");
  return last;
}

export interface SimPollState {
  state: "QUEUED" | "RUNNING" | "SUCCEEDED" | "FAILED";
  elapsedMs: number;
  terminal: boolean;
}

export interface SnowflakeSimResult extends SimPollState {
  handle: string;
}

export interface DatabricksSimResult {
  statement_id: string;
  status: { state: "QUEUED" | "RUNNING" | "SUCCEEDED" | "FAILED"; response_code?: number };
  elapsedMs: number;
  terminal: boolean;
}

/** Compatibility re-export of the Snowflake poll interval (lib-level, so the
 * route files stay export-clean). */
export const POLL_INTERVAL_MS = SNOWFLAKE_PARAMS.POLL_INTERVAL_MS;

/** Legacy two-argument state machine (band half-width from the constants),
 * preserved for the economics court/scorecard call sites. */
export function nextState(
  state: SnowflakeSimResult["state"],
  elapsedMs: number,
  params: typeof SNOWFLAKE_PARAMS = SNOWFLAKE_PARAMS,
): SnowflakeSimResult["state"] {
  const jitterBand = (params.JITTER_MS_MAX - params.JITTER_MS_MIN) / 2;
  if (state === "QUEUED" && elapsedMs >= params.COLD_START_LATENCY_MS - jitterBand) return "RUNNING";
  if (state === "RUNNING" && elapsedMs >= params.COLD_START_LATENCY_MS + jitterBand) return "SUCCEEDED";
  return state;
}

function simNextState(state: string, elapsedMs: number, coldStartMs: number, jitterMs: number): string {
  const halfBand = jitterMs;
  if (state === "QUEUED" && elapsedMs >= coldStartMs - halfBand) return "RUNNING";
  if (state === "RUNNING" && elapsedMs >= coldStartMs + halfBand) return "SUCCEEDED";
  return state;
}

/** Snowflake poll loop over the injected virtual clock (fast-forward surface;
 * no real timers). Same-band cold-start machine as the HTTP GET handler. */
export async function snowflakePollUntilTerminal(
  handle: string,
  clock: () => number,
  sleepMs: (ms: number) => Promise<void>,
): Promise<SnowflakeSimResult> {
  const { COLD_START_LATENCY_MS, JITTER_MS_MIN, JITTER_MS_MAX, POLL_INTERVAL_MS } = SNOWFLAKE_PARAMS;
  const jitterMs = handleJitterMs(handle, JITTER_MS_MIN, JITTER_MS_MAX);
  // Virtual-clock timeline only: the loop starts at first call (the injected
  // clock owns time); the wall-clock submit registry is the HTTP GET's
  // surface, not this fast-forward helper's.
  const started = clock();
  let state = "QUEUED";
  while (state !== "SUCCEEDED" && state !== "FAILED") {
    await sleepMs(POLL_INTERVAL_MS);
    state = simNextState(state, clock() - started, COLD_START_LATENCY_MS, jitterMs);
  }
  return { handle, state: state as SnowflakeSimResult["state"], elapsedMs: clock() - started, terminal: true };
}

/** Databricks poll loop over the injected virtual clock (fast-forward surface;
 * response_code present only on terminal states, per the graph model). */
export async function databricksPollUntilTerminal(
  statementId: string,
  clock: () => number,
  sleepMs: (ms: number) => Promise<void>,
): Promise<DatabricksSimResult> {
  const { COLD_START_LATENCY_MS, JITTER_MS_MIN, JITTER_MS_MAX, POLL_INTERVAL_MS } = DATABRICKS_PARAMS;
  const jitterMs = handleJitterMs(statementId, JITTER_MS_MIN, JITTER_MS_MAX);
  // Virtual-clock timeline only (see snowflake variant).
  const started = clock();
  let state = "QUEUED";
  while (state !== "SUCCEEDED" && state !== "FAILED") {
    await sleepMs(POLL_INTERVAL_MS);
    state = simNextState(state, clock() - started, COLD_START_LATENCY_MS, jitterMs);
  }
  const response_code = state === "SUCCEEDED" ? 200 : state === "FAILED" ? 422 : undefined;
  return {
    statement_id: statementId,
    status: { state: state as DatabricksSimResult["status"]["state"], response_code },
    elapsedMs: clock() - started,
    terminal: true,
  };
}
