// ---------------------------------------------------------------------------
// SUCCEEDED result pagination (gap S3/J3). First page inline on the terminal
// poll; opaque nextPageToken (handle + page index) only while rowCount
// exceeds pageSize; GET ?page=N (or ?pageToken=<token>) returns that slice.
// ---------------------------------------------------------------------------
const PAGE_SIZE = 10000; // rows per page (graph: pageSize, e.g. 10k)
const ROW_COUNT = 25000; // fabricated synthetic result cardinality per handle
const LAST_PAGE = Math.ceil(ROW_COUNT / PAGE_SIZE);

/** FNV-1a 32-bit over seed:handle:rowIndex — deterministic row content from
 * the sim seed; identical row index is byte-identical on every page fetch. */
function rowCell(handle: string, rowIndex: number, salt: string): string {
  let h = 0x811c9dc5;
  const input = `${JITTER_SEED}:${handle}:${salt}:${rowIndex}`;
  for (let i = 0; i < input.length; i++) {
    h ^= input.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h.toString(16).padStart(8, "0");
}

function rowFor(handle: string, rowIndex: number): string[] {
  return [String(rowIndex), `id-${rowCell(handle, rowIndex, "id")}`, `v-${rowCell(handle, rowIndex, "v")}`];
}

function buildPage(handle: string, page: number) {
  const start = (page - 1) * PAGE_SIZE;
  const end = Math.min(start + PAGE_SIZE, ROW_COUNT);
  const data: string[][] = [];
  for (let i = start; i < end; i++) data.push(rowFor(handle, i));
  return {
    rowCount: ROW_COUNT,
    pageSize: PAGE_SIZE,
    page,
    data,
    nextPageToken: page < LAST_PAGE ? `${handle}:page:${page + 1}` : undefined,
  };
}

/** Opaque nextPageToken -> page index (token form: "<handle>:page:<n>"). */
function pageFromToken(token: string): number {
  const parts = token.split(":page:");
  const n = Number(parts[parts.length - 1]);
  if (!Number.isInteger(n) || n < 1) throw new Error(`malformed pageToken: ${token}`);
  return n;
}

export async function GET(
  request: Request,
  ctx: { params: Promise<{ handle: string }> },
): Promise<Response> {
  const { handle } = await ctx.params;
  // Timeline anchor: the submit time recorded by the submit route; an
  // un-submitted handle starts its timeline at first observation.
  const submitMs = submitTimeOf(handle) ?? recordSubmitTime(handle);
  const elapsedMs = Date.now() - submitMs;
  // Deterministic per-handle jitter (hash of seed + handle — never Math.random),
  // so the same handle always walks the same QUEUED->RUNNING->SUCCEEDED timeline.
  const jitterMs = handleJitterMs(handle, JITTER_MS_MIN, JITTER_MS_MAX);
  const state: PollState = pollStateFor(elapsedMs, jitterMs, COLD_START_LATENCY_MS);

  if (state !== "SUCCEEDED") {
    const result: PollResult = { handle, state, elapsedMs, terminal: TERMINAL[state] };
    return new Response(JSON.stringify(result), {
      status: POLL_HTTP_STATUS[state],
    });
  }

  // SUCCEEDED: terminal poll carries the inline first page; ?page=N /
  // ?pageToken=<opaque token> returns that slice of the synthetic result.
  const url = new URL(request.url);
  const token = url.searchParams.get("pageToken");
  const pageParam = url.searchParams.get("page");
  let page = 1;
  if (token !== null) page = pageFromToken(token);
  else if (pageParam !== null) page = Number(pageParam);
  const resultSet = buildPage(handle, page);
  const bodyText = JSON.stringify({ handle, state, elapsedMs, terminal: true, resultSet });
  // LEDGER BRIDGE: terminal observation — charge the real egress bytes of
  // this response to the handle's submit-time record.
  recordEgress(handle, Buffer.byteLength(bodyText));
  return new Response(bodyText, {
    status: POLL_HTTP_STATUS.SUCCEEDED,
  });
}
