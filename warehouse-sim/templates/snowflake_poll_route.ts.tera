import { recordEgress } from "../../../../../lib/admin_engine.ts";

const { COLD_START_LATENCY_MS, JITTER_MS_MIN, JITTER_MS_MAX } = SNOWFLAKE_PARAMS;

// States rendered from sim:hasState facts (HTTP status from sim:httpStatus):
{% for r in results %}//   {{ r.stateLabel }} -> HTTP {{ r.httpStatus }}
{% endfor %}
{% for r in results %}{% if loop.first %}export type PollState ={% endif %} "{{ r.stateLabel }}"{% if not loop.last %} |{% endif %}{% if loop.last %};

