function buildPollUrl(basePath: string, handle: string): string {
  return `${basePath}/${handle}`;
}

// Shared submit semantics (moved verbatim from the route modules).
export function snowflakeSubmit(req: SnowflakeSubmitRequest): SnowflakeSubmitResponse {
  if (!req.asyncMode) {
    throw new Error("SQL API v2 returns 202 only in async mode; set asyncMode: true");
  }
  const handle = crypto.randomUUID();
  return {
    statementHandle: handle,
    pollUrl: buildPollUrl(SNOWFLAKE_BASE_PATH, handle),
    status: SNOWFLAKE_SUBMIT_STATUS,
  };
}

export function databricksSubmit(req: DatabricksSubmitRequest): DatabricksSubmitResponse {
  const statementId = crypto.randomUUID();
  return {
    statement_id: statementId,
    pollUrl: buildPollUrl(DATABRICKS_BASE_PATH, statementId),
    status: { state: "QUEUED" },
  };
}
