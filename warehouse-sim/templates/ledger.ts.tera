{% for r in results %}// GENERATED by ggen from warehouse-sim/schema/warehouse_sim.ttl — edit the graph.
// Rule: ledger-constants. Virtual credit + byte ledger (simulator constants;
// ASSUMPTION-UNVERIFIED in the graph — re-pin before real invoice claims).

export const LEDGER_TITLE = "{{ r.sfLabel }}";
export const creditCostPerHour = {{ r.creditCostPerHour }};
export const dcuCostPerHour = {{ r.dcuCostPerHour }};
export const scanRatePerTB = {{ r.sfScanRatePerTB }};

export interface LedgerEntry {
  warehouseHours: number;
  dcuHours: number;
  bytesScanned: number;
}

export function creditCost(entry: LedgerEntry): number {
  const warehouseCredits = entry.warehouseHours * creditCostPerHour;
  const dcuCredits = entry.dcuHours * dcuCostPerHour;
  const scanCredits = (entry.bytesScanned / Math.pow(1024, 4)) * scanRatePerTB;
  return warehouseCredits + dcuCredits + scanCredits;
}
{% endfor %}