# Rust
target/
**/*.rs.bk
*.pdb
# Cargo.lock is COMMITTED (both root and test-dependency): the workspace ships
# binaries (test-validation bin, repo doctor tooling), so the lockfile is
# required for reproducible builds — cargo's library-only exception does not
# apply. Decision recorded in docs/sjira/v2.0.0-dev/COMMIT-PLAN.md (Z3 close).
!Cargo.lock
!test-dependency/Cargo.lock

# Lane-local CARGO_HOME (T1 lane lease)
.cargo-laneT1/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Environment files
.env
.env.local
.env.*.local

# Test coverage
tarpaulin-report.html
cobertura.xml

# Documentation
/book/

# Backup files
*.bak
*.backup
.lh/

# ggen runtime state (secrets law: signing keypair + receipt log never enter
# version control; `ggen sync run` regenerates them — see docs/GENESIS.md and
# PACK_FEEDBACK.md G4 #2 for the pack-side remedy)
.ggen/
.ggen-v2/
__pycache__/
*.pyc

# Lane build roots (leases, not assets — deleted at integration; see
# same-checkout-fanout cleanup law)
target-lane*/
target-gap*/
target-cg*/
target-dt*/
target-fx*/
target-lane*/
target-integration/

# Stray linker output
*.rlib

# warehouse-sim (Next.js sim): package-lock.json ignored by decision —
# reproducible via `npm install`; node_modules/ and .next/ are covered by
# warehouse-sim/.gitignore
warehouse-sim/package-lock.json

# Dependency-probe build dirs (test-dependency lane scratch)
test-dependency/target-dep-coord/

# Court/fixture scratch is written under /tmp — nothing repo-side to ignore;
# entries here would be dead patterns. (No /tmp fixture paths are tracked.)
target-*/
doctor-target/
