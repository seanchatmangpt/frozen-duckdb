# frozen-duckdb project domain ontology (consumer-side facts)
# Standard vocabularies only (dcterms, prov, skos) per marketplace law.
# ret: (retrofit) IRIs are the repo-reconciliation-pack 26.7.20 vocabulary.
# The pack's own ontology.ttl is deliberately NOT imported: it seeds example
# instances on the canonical ret:StateFound/ret:Delta/ret:Reconciliation/
# ret:RecertificationReceipt subjects, and a union merge would co-render
# those placeholders into the v1.5.5 reconciliation artifacts (empirically
# probed 2026-09-21). This file supplies the REAL frozen-duckdb instances
# instead; the dep-pack ontologies (as-found/load-path/intervention/
# temporary-works/mermaid) ARE imported via ggen.toml [ontology].imports --
# verified collision-free with every reconciliation query target.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ret:    <https://seanchatmangpt.github.io/ontology/retrofit#> .
@prefix fd:     <https://seanchatmangpt.github.io/frozen-duckdb/ns#> .

fd:project a prov:Entity ;
    dcterms:title "frozen-duckdb" ;
    dcterms:description "Pre-compiled DuckDB binaries for Rust: drop-in duckdb-rs replacement" ;
    dcterms:version "1.5.5" ;
    prov:wasDerivedFrom <https://github.com/duckdb/duckdb/releases/tag/v1.5.5> .

# DuckDB version law: crate version mirrors the bundled upstream release
fd:duckdbVersionLaw a skos:Concept ;
    skos:prefLabel "crate version mirrors bundled DuckDB release" ;
    skos:notation "1.5.5" .

# ---------------------------------------------------------------------------
# C3 reconciliation — v1.5.5 milestone, wave 4 (2026-09-21)
# Evidence standard: every graphHash/decisionReason below is an observed,
# reproducible command or artifact, not an assertion. Standing ceiling is the
# weakest observed state (as-operated is pre-publish), so andon=Yellow and
# promotionAllowed=false while the blocking operator-cuts obligation is open.
# ---------------------------------------------------------------------------

# -- States (canonical generation frame G0..G3, real content hashes) --------

fd:asFound a ret:RepositoryState ;
    ret:stateId "G0-as-found" ;
    ret:stateKind ret:AsFound ;
    ret:graphHash "sha256:5624a1091b2cfa3cc2d7c89a6e8c2670ea4e281f1a72baf27c1ec0996bee2d79" ;
    ret:generationIndex 0 ;
    ret:nextState fd:asDesired ;
    dcterms:description "master@1c84384 (2026-08-23): workspace version 1.4.0, never compiled against DuckDB 1.5.x, release pipeline shipped fictional libfrozen_mega_{arch} assets. Tree hash: git archive 1c84384 | shasum -a 256." .

fd:asDesired a ret:RepositoryState ;
    ret:stateId "G1-as-desired" ;
    ret:stateKind ret:AsDesired ;
    ret:graphHash "sha256:43765fb2431e1145800f97788ebec585d344b3b406b7d5cb3f800d478f83ecd5" ;
    ret:generationIndex 1 ;
    ret:nextState fd:asBuilt ;
    dcterms:description "Issue #1 answered by PR #3 (feat: DuckDB 1.5.5 support - pin bump, release asset fix, API layer restoration; base master, head feat/duckdb-1.5.5; 8/8 CI checks SUCCESS observed 2026-09-21 via gh). Design-record hash: sha256 over PR_BODY.md + ISSUE_1_COMMENT.md + MILESTONE.md." .

fd:asBuilt a ret:RepositoryState ;
    ret:stateId "G2-as-built" ;
    ret:stateKind ret:AsBuilt ;
    ret:graphHash "sha256:8451d477a9dfe5ddaf095050c8f973342370e5caad78d6ccf20a7ffb831e9863" ;
    ret:generationIndex 2 ;
    ret:nextState fd:asOperated ;
    dcterms:description "feat/duckdb-1.5.5@1b41188: 301 tests green (T2A/T2B History), cargo fmt --check = 0 findings, clippy --workspace --all-targets --all-features -D warnings exit 0 (T5 History), cargo build --workspace exit 0. Tree hash: git archive 1b41188 | shasum -a 256." .

fd:asOperated a ret:RepositoryState ;
    ret:stateId "G3-as-operated" ;
    ret:stateKind ret:AsOperated ;
    ret:graphHash "sha256:bd6480b0a00decdcab5770f51d90e96b893b0e27307d664ef74a4b5fcf0bb755" ;
    ret:generationIndex 3 ;
    dcterms:description "Pre-publish: no tag, no release, no crates.io publication. Operator cut sequence pending per docs/sjira/v26.9.21/PUBLISH_RUNBOOK.md. Hash: sha256 over PUBLISH_RUNBOOK.md (the record of the pending operation)." .

# -- Deltas as-found -> as-built (all classified; none blocking) -------------
# Every delta carries deltaClass + admissionDecision + decisionReason + blocking
# (gate 010_delta_classification_required). The one Admitted Deletion carries an
# explicit decisionReason (gate 030_deletion_requires_refusal_or_explicit_admission).
# Evidence for the span: git diff 1c84384..1b41188 = 173 files,
# sha256(diffstat) = 5a812d16804514f576817b70bf2f326b0a0fc48c588abe31161c4afe4a360caa.

fd:delta-pins a ret:Delta ;
    ret:deltaId "pins-1.4.0-to-1.5.5" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Modification ;
    ret:targetSurface "workspace+builder+scripts+CI version pins" ;
    ret:beforeValue "1.4.0 (Cargo.toml workspace version, builder pins, script clones)" ;
    ret:afterValue "1.5.5 everywhere; scripts pin --branch v1.10505.0; zero live v1.4 pins (T6 grep gate)" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Crate version mirrors bundled DuckDB 1.5.5 (fd:duckdbVersionLaw); closes issue #1" ;
    ret:blocking false .

fd:delta-release-assets a ret:Delta ;
    ret:deltaId "release-asset-naming-fix" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Modification ;
    ret:targetSurface "github_workflow build-binaries.yml asset naming" ;
    ret:beforeValue "libfrozen_mega_{arch} uploaded at 1c84384; ensure_binary() downloads libduckdb_{arch}.dylib that never existed upstream (fictional release pipeline)" ;
    ret:afterValue "assets published as libduckdb_{arch}.dylib matching ensure_binary() (T5 re-verification; CI green on PR #3)" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Repairs the only download path consumers have; CI check evidence on PR #3" ;
    ret:blocking false .

fd:delta-builder a ret:Delta ;
    ret:deltaId "builder-vendored-headers" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Addition ;
    ret:targetSurface "frozen-duckdb-builder" ;
    ret:beforeValue "absent: no vendored headers, no cache normalization guarantee" ;
    ret:afterValue "vendored duckdb/{duckdb.h,duckdb.hpp} for 1.5.5; cache normalization on every acquisition path (T7 probes P1-P4 PASS)" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Offline builds + cache repair by execution evidence (T7 History)" ;
    ret:blocking false .

fd:delta-sys-bindgen a ret:Delta ;
    ret:deltaId "sys-bindgen-links" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Modification ;
    ret:targetSurface "frozen-duckdb-sys bindgen + links" ;
    ret:beforeValue "double-include rot; no links=duckdb metadata" ;
    ret:afterValue "double-include fixed; links=duckdb emits DEP_DUCKDB_* for @rpath propagation; C API 1.4->1.5 diff: 0 removals / 0 renames / 459 referenced symbols present (bindgen SAFE)" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "MILESTONE.md observed diff + T5/T7 gate evidence" ;
    ret:blocking false .

fd:delta-api-layer a ret:Delta ;
    ret:deltaId "api-layer-restoration" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Addition ;
    ret:targetSurface "vendored duckdb-rs API layer (frozen-duckdb crate)" ;
    ret:beforeValue "non-compiling 1.4.0-era sources (crate:: wiring broken, stale deps)" ;
    ret:afterValue "compiles against 1.5.5: arrow 56 / hashlink 0.10 / strum 0.27 / fallible-* / rust_decimal / cast; cargo build --workspace exit 0" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Compilation is the MILESTONE Done gate; observed exit 0 this wave" ;
    ret:blocking false .

fd:delta-scripts a ret:Delta ;
    ret:deltaId "scripts-fiction-removal" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Modification ;
    ret:targetSurface "scripts/create_frozen_setup.sh + scripts/build_frozen_duckdb.sh" ;
    ret:beforeValue "fetch scheme targeted upstream assets that never existed; duckdb-rs clone unpinned; v1.4.1/v1.4.x pins" ;
    ret:afterValue "fetches this repo's GitHub Releases; --branch v1.10505.0; bash -n clean (T6 ALIVE)" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Removes fictional capability; real scheme verified against ensure_binary() contract" ;
    ret:blocking false .

fd:delta-test-suites a ret:Delta ;
    ret:deltaId "test-suites-1.5.5" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Modification ;
    ret:targetSurface "tests/ + examples import surface" ;
    ret:beforeValue "'use duckdb::' rot; todo!() match fallthrough on unknown 1.5.5 columns (GEOMETRY); polars/flock/tpch ungated" ;
    ret:afterValue "frozen_duckdb:: everywhere; 301 tests green across core+extension suites; runtime-gated skips documented (T2A/T2B ALIVE)" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Test execution against the real 1.5.5 dylib is the ALIVE standard; preserved in T2A/T2B History" ;
    ret:blocking false .

fd:delta-hygiene a ret:Delta ;
    ret:deltaId "root-rot-removal" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Deletion ;
    ret:targetSurface "repo root: demo_ffi_validation.sh, test_ffi_validation.rs, test_datasets/, orphan scratch" ;
    ret:beforeValue "present (echo-theater demo that fabricated success evidence; committed generated datasets)" ;
    ret:afterValue "removed" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "Explicit admission: files fabricated success evidence (dcaecf3) or were orphan/generated rot (37f94c1); no behavior lost -- removal verified by full build+test green after deletion" ;
    ret:blocking false .

fd:delta-reconciliation a ret:Delta ;
    ret:deltaId "reconciliation-capability" ;
    ret:fromState fd:asFound ; ret:toState fd:asBuilt ;
    ret:deltaClass ret:Addition ;
    ret:targetSurface "ggen.toml; schema/; gates/; docs/sjira/v26.9.21/reconciliation/" ;
    ret:beforeValue "absent: no marketplace projection, no reconciliation law" ;
    ret:afterValue "repo-reconciliation-pack family declared; pack gates execute as sync law; artifacts rendered from facts" ;
    ret:admissionDecision ret:Admitted ;
    ret:decisionReason "C3 wave-4 capability composition (this delta)" ;
    ret:blocking false .

# -- Obligation, reconciliation judgment, receipt chain ----------------------

fd:obligation-operator-cuts a ret:Obligation ;
    dcterms:title "Operator cuts: merge PR #3, tag v1.5.5, verify release assets, cargo publish, post issue #1 comment" ;
    ret:obligationStatus "open" ;
    ret:blocking true .

fd:reconciliation-001 a ret:Reconciliation ;
    ret:fromState fd:asBuilt ;
    ret:toState fd:asOperated ;
    ret:obligation fd:obligation-operator-cuts ;
    ret:andon ret:Yellow ;
    ret:standingCeiling ret:R4 ;
    ret:promotionAllowed false .

fd:receipt-001 a ret:RecertificationReceipt ;
    ret:previousReceiptHash "GENESIS" ;
    ret:receiptHash "sha256:5a812d16804514f576817b70bf2f326b0a0fc48c588abe31161c4afe4a360caa" ;
    ret:andon ret:Yellow ;
    ret:standingCeiling ret:R4 ;
    ret:promotionAllowed false .
